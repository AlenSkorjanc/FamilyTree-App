# Local defaults already match these values. Override only when needed.
SPRING_PROFILES_ACTIVE=
PORT=8080
POSTGRES_DB=family_tree
POSTGRES_USER=family_tree
POSTGRES_PASSWORD=family_tree
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/family_tree
DB_USERNAME=family_tree
DB_PASSWORD=family_tree
# Koyeb/Neon production uses these Spring-standard names instead of DB_*.
SPRING_DATASOURCE_URL=jdbc:postgresql://NEON_HOST/NEON_DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=NEON_USERNAME
SPRING_DATASOURCE_PASSWORD=replace-with-a-secret
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
JWT_SECRET=development-only-change-this-32-byte-secret
JWT_ISSUER=family-tree-api
JWT_AUDIENCE=family-tree-web
JWT_ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
PHOTO_STORAGE_PATH=./data/photos
PHOTO_UPLOADS_ENABLED=true
VITE_API_PROXY_TARGET=http://localhost:8080

# Development email inbox: run `docker compose up -d mailpit`, then open http://localhost:8025
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=noreply@familytree.local
VERIFICATION_TOKEN_TTL=24h
PASSWORD_TOKEN_TTL=30m
